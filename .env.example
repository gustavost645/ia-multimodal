# GEMINI_API_KEY: chave da API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: modelo principal usado na análise do ambiente (opcional)
GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_FALLBACK_MODELS: modelos de reserva, separados por vírgula, usados
# quando o principal está sobrecarregado ou sem cota (opcional)
GEMINI_FALLBACK_MODELS="gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash"

# GEMINI_IMAGE_MODEL / GEMINI_IMAGE_FALLBACK_MODELS: modelos de geração de imagem da
# "foto realista" (exigem faturamento ativo na chave do Gemini; opcionais)
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
GEMINI_IMAGE_FALLBACK_MODELS="gemini-2.5-flash-image"

# APP_URL: URL pública da aplicação (opcional em desenvolvimento local)
APP_URL="http://localhost:3000"

# CHATGPT_API_KEY (ou OPENAI_API_KEY): chave da OpenAI, usada como reserva quando o Gemini
# estoura a cota (análise, detecção e foto realista). Opcional; exige créditos na conta.
CHATGPT_API_KEY=""
# OPENAI_MODEL: modelo de texto/visão da reserva (opcional)
OPENAI_MODEL="gpt-5-mini"
# OPENAI_IMAGE_MODEL: modelo de edição de imagem da reserva (opcional)
OPENAI_IMAGE_MODEL="gpt-image-1.5"

# AIHUBMIX_API_KEY: chave da AIHubMix (agregador de modelos). Usada como reserva do Gemini; o modelo
# gratuito de visão detecta os móveis da foto sem custo. Opcional.
AIHUBMIX_API_KEY=""
# AIHUBMIX_BASE_URL: endereço da AIHubMix (opcional)
AIHUBMIX_BASE_URL="https://aihubmix.com"
# AIHUBMIX_FREE_VISION_MODEL: modelo gratuito de visão (opcional)
AIHUBMIX_FREE_VISION_MODEL="nemotron-3.5-super-vl-free"

# OPENROUTER_API_KEY: chave do OpenRouter (https://openrouter.ai/keys). Reserva do Gemini: os modelos ":free"
# fazem a análise/detecção sem custo (50 requisições/dia sem créditos). Opcional.
OPENROUTER_API_KEY=""
# OPENROUTER_MODELS: modelos de visão, em ordem, separados por vírgula (opcional)
OPENROUTER_MODELS="nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free"
# OPENROUTER_IMAGE_MODELS: modelos da foto realista (pagos: exigem créditos no OpenRouter; opcional)
OPENROUTER_IMAGE_MODELS="google/gemini-3.1-flash-image,google/gemini-2.5-flash-image"
